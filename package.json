{
  "name": "upiwise",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:api": "tsx backend/localServer.ts",
    "build": "tsc && vite build",
    "build:lambda": "esbuild backend/lambda.ts --bundle --platform=node --target=node20 --outfile=dist-lambda/index.js",
